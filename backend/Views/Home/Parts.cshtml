@{
    ViewData["Title"] = "Parts Manager";
    Layout = "_Layout";
}

<style>
    .btn-animated:hover {
        transform: scale(1.05);
        transition: 0.2s ease;
    }
</style>

<h1 class="mb-4">Parts Manager</h1>

<div class="mb-3">
    <a href="/" class="btn btn-secondary">Back to Cars</a>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h2 class="h5">Add/Edit Part</h2>
    </div>
    <div class="card-body">
        <form id="addPartForm" class="row g-3">
            <input type="hidden" id="partId">
            <div class="col-md-6">
                <label for="partName" class="form-label">Name</label>
                <input type="text" class="form-control" id="partName" required>
            </div>
            <div class="col-md-4">
                <label for="partPrice" class="form-label">Price</label>
                <input type="number" step="0.01" class="form-control" id="partPrice" required>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" id="partSubmitBtn" class="btn btn-primary btn-animated">Add Part</button>
                <button type="button" id="partCancelBtn" class="btn btn-secondary btn-animated ms-2" style="display:none;">Cancel</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="h5">Parts List</h2>
    </div>
    <div class="card-body">
        <table id="partsTable" class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<script>
    const partsApiUrl = '/api/parts';

    document.getElementById('addPartForm').addEventListener('submit', addOrUpdatePart);
    document.getElementById('partCancelBtn').addEventListener('click', resetPartForm);

    // Автоматическая загрузка данных при загрузке страницы
    loadParts();

    async function loadParts() {
        const response = await fetch(partsApiUrl);
        const parts = await response.json();
        const tbody = document.querySelector('#partsTable tbody');
        tbody.innerHTML = '';
        parts.forEach(part => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${part.id}</td>
                <td>${part.name}</td>
                <td>${part.price}</td>
                <td>
                    <button class="btn btn-warning btn-sm btn-animated me-2" onclick="editPart(${part.id}, '${part.name}', ${part.price})">Edit</button>
                    <button class="btn btn-danger btn-sm btn-animated" onclick="deletePart(${part.id})">Delete</button>
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    async function addOrUpdatePart(e) {
        e.preventDefault();
        const partId = document.getElementById('partId').value;
        const part = {
            name: document.getElementById('partName').value,
            price: parseFloat(document.getElementById('partPrice').value)
        };
        let response;
        if (partId) {
            response = await fetch(`${partsApiUrl}/${partId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(part)
            });
            if (response.ok) {
                alert('Part updated');
                resetPartForm();
                loadParts();
            }
        } else {
            response = await fetch(partsApiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(part)
            });
            if (response.ok) {
                alert('Part added');
                resetPartForm();
                loadParts();
            }
        }
    }

    function editPart(id, name, price) {
        document.getElementById('partId').value = id;
        document.getElementById('partName').value = name;
        document.getElementById('partPrice').value = price;
        document.getElementById('partSubmitBtn').textContent = 'Update Part';
        document.getElementById('partCancelBtn').style.display = 'inline-block';
    }

    function resetPartForm() {
        document.getElementById('addPartForm').reset();
        document.getElementById('partId').value = '';
        document.getElementById('partSubmitBtn').textContent = 'Add Part';
        document.getElementById('partCancelBtn').style.display = 'none';
    }

    async function deletePart(id) {
        if (confirm('Are you sure you want to delete this part?')) {
            const response = await fetch(`${partsApiUrl}/${id}`, { method: 'DELETE' });
            if (response.ok) {
                alert('Part deleted');
                loadParts();
            }
        }
    }
</script>